# Copy to .env and run: docker run --rm --env-file .env -v "$PWD/output:/app/output" cr-drafter
CR_APPLICATION=payments-api
CR_RELEASE_VERSION=1.4.2
CR_ENVIRONMENT=Production
CR_ID=CHG0012345
CR_REASON=fix the intermittent payment timeout reported by customers
CR_DESCRIPTION=Deploys payments-api 1.4.2 which fixes the gateway timeout and updates base image dependencies.
CR_CHANGE_WINDOW=Thu 12 Nov 2026 20:00-22:00 GMT
CR_REQUESTER=Platform Team
REPORT_FORMATS=csv,pdf
# LOG_LEVEL=INFO
# MOCK_MODE=true

SONAR_URL=https://sonarqube.example.com
SONAR_TOKEN=
SONAR_PROJECT=payments-api
SONAR_BRANCH=main

ANCHORE_URL=https://anchore.example.com
ANCHORE_USER=
ANCHORE_PASSWORD=
ANCHORE_API=v2
ANCHORE_IMAGE=registry.example.com/payments/payments-api:1.4.2

OCP_API=https://api.cluster.example.com:6443
OCP_TOKEN=
OCP_NAMESPACE=security-scans
OCP_LABEL_SELECTOR=job-name=zap-payments-api
# OCP_POD=zap-payments-api-x7k2p
# CA_BUNDLE=/certs/ca.crt
